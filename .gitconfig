# ~/.gitconfig — symlinked from ~/dotfiles/.gitconfig by install.sh
#
# Identity (name/email) lives in ~/.gitconfig.local, which is NOT committed.
# install.sh creates it on first run. Anything in it overrides this file.

[alias]
	st = status
	ad = add
	aa = add -A
	cm = commit -m
	ca = !git add -A && git commit -av
	amn = commit --amend --reuse-message=HEAD
	sa = stash
	br = branch
	ch = checkout
	plr = pull --rebase
	ps = push
	# Switch to a branch, creating it if necessary: `git go feature-x`
	go = "!f() { git switch \"$1\" 2>/dev/null || git switch -c \"$1\"; }; f"

[core]
	excludesfile = ~/.gitignore_global
	# Flag spaces before tabs and trailing whitespace
	whitespace = space-before-tab,-indent-with-non-tab,trailing-space
	# Make `git rebase` safer on macOS
	trustctime = false
	pager = less -FRX

[apply]
	whitespace = fix

[color]
	ui = auto
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green
[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red
	new = green
[color "status"]
	added = yellow
	changed = green
	untracked = cyan

[diff]
	renames = copies

[fetch]
	# Remove local refs to branches deleted on the remote
	prune = true

[help]
	# Suggest the corrected command and ask before running it
	autocorrect = prompt

[merge]
	log = true

[push]
	# Push the current branch to a branch of the same name, and set upstream
	default = current
	autoSetupRemote = true

[include]
	path = ~/.gitconfig.local
